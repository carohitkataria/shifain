# Password for the /admin homepage control panel.
ADMIN_PASSWORD=change-me-in-production

# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SECRET=generate-a-long-random-string

# Optional: absolute path to the homepage content JSON store.
# Defaults to <project>/content/homepage.json
# SHIFAIN_CONTENT_PATH=/var/data/shifain/homepage.json
