# Password for the /admin homepage control panel.
ADMIN_PASSWORD=change-me-in-production

# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SECRET=generate-a-long-random-string

# Optional: absolute path to the homepage content JSON store.
# Defaults to <project>/content/homepage.json
# SHIFAIN_CONTENT_PATH=/var/data/shifain/homepage.json

# Connection string for the ShifaIn catalogue and case database.
# Without it the site still renders, but the AI plan, the case file and the
# partner portals are all unavailable.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=shifain

# Key for the Claude API, which reads uploaded reports and writes the plan.
# Without it an uploaded case is still opened and a coordinator picks it up.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: signs the partner-portal session cookie. Falls back to ADMIN_SECRET.
# PARTNER_SECRET=generate-a-different-long-random-string
