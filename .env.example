# Password for the /admin homepage control panel.
ADMIN_PASSWORD=change-me-in-production

# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SECRET=generate-a-long-random-string

# Optional: absolute path to the homepage content JSON store.
# Defaults to <project>/content/homepage.json
# SHIFAIN_CONTENT_PATH=/var/data/shifain/homepage.json

# Connection string for the ShifaIn catalogue and case database.
# Without it the site still renders, but the AI plan, the case file and the
# partner portals are all unavailable.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=shifain

# Key for the Claude API, which reads uploaded reports and writes the plan.
# Without it an uploaded case is still opened and a coordinator picks it up.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: signs the partner-portal session cookie. Falls back to ADMIN_SECRET.
# PARTNER_SECRET=generate-a-different-long-random-string

# Optional: sends the patient sign-in code by email (Resend).
# Without these, sign-in still works but the code has to be read out by a
# coordinator — it is shown to them, never silently swallowed.
# RESEND_API_KEY=re_...
# MAIL_FROM=ShifaIn <care@shifain.com>

# Telegram bot token from @BotFather. A single token serves both
# patient and partner roles. Set separate *_PATIENT_BOT_TOKEN /
# *_PARTNER_BOT_TOKEN only if you use two bots.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Public base URL of the deployment (used for Telegram webhook registration).
# The webhook URL becomes $BASE_URL/api/telegram/webhook?bot=patient
# BASE_URL=https://shifain.onrender.com
