# Password for the /admin homepage control panel.
ADMIN_PASSWORD=change-me-in-production

# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SECRET=generate-a-long-random-string

# Optional: absolute path to the homepage content JSON store.
# Defaults to <project>/content/homepage.json
# SHIFAIN_CONTENT_PATH=/var/data/shifain/homepage.json

# Connection string for the ShifaIn catalogue and case database.
# Without it the site still renders, but the AI plan, the case file and the
# partner portals are all unavailable.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=shifain

# Key for the Claude API, which reads uploaded reports and writes the plan.
# Without it an uploaded case is still opened and a coordinator picks it up.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: signs the partner-portal session cookie. Falls back to ADMIN_SECRET.
# PARTNER_SECRET=generate-a-different-long-random-string

# Sends patient sign-in codes and case updates by email (Resend).
# Without it, email codes cannot be delivered in production (they are never
# shown on the page), so patients sign in with WhatsApp or Telegram, a
# password, or their case reference and phone. Locally the code is shown.
# RESEND_API_KEY=re_...
# MAIL_FROM=ShifaIn <care@shifain.com>

# Telegram bot token from @BotFather. A single token serves both
# patient and partner roles. Set separate *_PATIENT_BOT_TOKEN /
# *_PARTNER_BOT_TOKEN only if you use two bots.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Public base URL of the deployment (used for Telegram webhook registration).
# The webhook URL becomes $BASE_URL/api/telegram/webhook?bot=patient
# BASE_URL=https://shifain.onrender.com

# ElevenLabs API key for voice AI (speech-to-text + text-to-speech).
# Without it, voice messages still work but get a text-only reply.
# ELEVENLABS_API_KEY=sk_...

# Google Gemini API key for the voice conversation engine (free tier).
# Get one free at https://aistudio.google.com/apikey
# When set, the voice agent uses Gemini instead of Claude — good for testing.
# GEMINI_API_KEY=AIza...

# Where "action needed" alerts go (a failed automatic plan, files that could
# not be stored) when no ops email is set in the console's Settings.
# OPS_EMAIL=care@example.com

# Sign-in codes on WhatsApp (Meta WhatsApp Cloud API). Needs a WhatsApp
# Business number and an approved "Authentication" template.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=shifain_login_code
# WHATSAPP_OTP_LANGUAGE=en

# The patient bot's @username, for "Message us on Telegram" and Telegram
# sign-in. Read from Telegram when not set.
# TELEGRAM_PATIENT_BOT_USERNAME=
